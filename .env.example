# Public website
NEXT_PUBLIC_APP_URL=https://www.legaltrademarkoffice.com
NEXT_PUBLIC_APP_NAME=Legal Trademark Office

# Google Maps address suggestions
# Enable Maps JavaScript API + Places API in Google Cloud.
# Restrict this browser key to your production and preview domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google reCAPTCHA
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_DISABLE_CAPTCHA=false

# NMI payment gateway
NEXT_PUBLIC_NMI_TOKENIZATION_KEY=
NMI_SECURITY_KEY=
NMI_GATEWAY_URL=https://secure.nmi.com
NEXT_PUBLIC_PAYMENT_BYPASS_MODE=false

# Lead notification email
MAILER_EMAIL=
MAILER_PASSWORD=

# Receipt/support SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
BILLING_EMAIL=
BILLING_EMAIL_PASSWORD=
SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=

# Optional CRM integrations
CRM_INGEST_URL=
CRM_INGEST_API_KEY=
DISABLE_ZOHO=true
# Full Zoho function URL including its server-side credential. Never expose it
# through a NEXT_PUBLIC variable or commit the real value.
ZOHO_LEAD_ENDPOINT=

# Uploads
NEXT_PUBLIC_CLOUDINARY_PRESET=

# Firebase browser configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (server only; never prefix with NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Background portal recommendation personalization (server only)
# The portal still uses safe rule-based recommendations when this is empty.
OPENAI_API_KEY=
OPENAI_PORTAL_AI_ENABLED=true
OPENAI_PORTAL_MODEL=gpt-5-nano
OPENAI_PORTAL_WEEKLY_REQUEST_LIMIT=250
OPENAI_PORTAL_MAX_OUTPUT_TOKENS=400

# NMI Customer Vault (saved cards) is a paid add-on. Leave false unless the
# merchant account has it provisioned: without it the gateway rejects the
# entire sale rather than skipping the vault.
NEXT_PUBLIC_NMI_CUSTOMER_VAULT_ENABLED=false
